<%- include('partials/header', { title, active }) %>

<p><a href="/runs/<%= score.runId %>">← Run #<%= score.runId %></a></p>
<div class="head-row">
  <h1><%= score.site.name %></h1>
  <% if (!isLive) { %>
    <form method="post" action="/runs/<%= score.runId %>/sites/<%= score.siteId %>/recapture"
          onsubmit="return confirm('Recapturer toutes les pages de ce site et recalculer son score ?');">
      <button class="btn" type="submit">↻ Relancer la capture de ce site</button>
    </form>
  <% } else { %>
    <span class="muted">Un run est en cours — recapture indisponible.</span>
  <% } %>
</div>
<p class="muted"><%= categoryLabel(score.category) %></p>
<% if (flash) { %><div class="flash warn"><%= flash %></div><% } %>

<%
  var allPages = pages || [];
  // The two families are never mixed: a China page is graded on the first
  // criterion of each topic (plus topic 12), a standard page on all of them.
  var stdPages = allPages.filter(function(p){ return !p.isChina; });
  var cnPages  = allPages.filter(function(p){ return p.isChina; });
  var cnTopics = chinaTopics || null;
  function hasScores(list){ return list.some(function(p){ return p.topics && p.topics.length; }); }
  function pTopic(p, id){ return (p.topics || []).find(function(t){ return t.topicId === id; }); }
  function pCtrl(pt, cid){ return pt ? (pt.controls || []).find(function(c){ return c.controlId === cid; }) : undefined; }
  // A criterion computed from the other topics is rewritten at every re-score:
  // correcting it by hand would be silently undone, so it stays read-only.
  var derived = derivedIds || [];
  function isDerived(cid){ return derived.indexOf(cid) !== -1; }
  // « À confirmer »: the engine could not measure the criterion and no operator
  // has arbitrated it yet. It counts as a failure meanwhile, so any score above
  // it is provisional.
  var sitePending = typeof pending !== 'undefined' ? (pending || 0) : 0;
  var cnPending = typeof chinaPending !== 'undefined' ? (chinaPending || 0) : 0;
  function isPending(c){ return c && c.unknown && !c.manual; }
%>
<%
  function provisional(n) {
%><% if (n) { %><span class="provisional" title="Ces critères comptent comme échec tant qu'ils ne sont pas arbitrés">provisoire — <%= n %> critère<%= n > 1 ? 's' : '' %> à confirmer</span><% } %><%
  }
%>

<p class="muted note">
  ✏️ Un verdict par page est modifiable : le score du sujet, du site et le global
  sont recalculés aussitôt. La correction ne vit que dans ce résultat —
  recapturer la page la remplace par la mesure.
  <span class="unknown-flag">?</span> « à confirmer » : le contrôle n'a pas pu mesurer —
  compté comme échec tant qu'un opérateur ne tranche pas, et le score reste provisoire.
</p>

<h2>Synthèse<% if (cnPages.length) { %> — pages hors China<% } %></h2>
<% if (!stdPages.length) { %>
  <p class="muted">Aucune page hors China dans ce run : seul le bloc China ci-dessous est renseigné.</p>
<% } else { %>
<%
  var hasPageScores = hasScores(stdPages);
%>
<div class="scroll-x">
<table class="grid small">
  <thead>
    <tr>
      <th></th>
      <% if (hasPageScores) { stdPages.forEach(function(p){ %><th title="<%= p.url %>"><%= p.label %></th><% }); } %>
      <th>Site</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><strong>Global</strong></td>
      <% if (hasPageScores) { stdPages.forEach(function(p){ %>
        <td><span class="score sm <%= scoreClass(p.overall) %>"><%= fmtScore(p.overall) %></span><% if (p.pending) { %><span class="provisional-mark" title="Score provisoire — <%= p.pending %> critère(s) à confirmer">?</span><% } %></td>
      <% }); } %>
      <td><span class="score <%= scoreClass(score.overall) %>"><%= fmtScore(score.overall) %></span> <% provisional(sitePending) %></td>
    </tr>
    <tr>
      <td>GEO</td>
      <% if (hasPageScores) { stdPages.forEach(function(p){ %>
        <td><span class="score sm <%= scoreClass(p.geo) %>"><%= fmtScore(p.geo) %></span></td>
      <% }); } %>
      <td><span class="score <%= scoreClass(score.geo) %>"><%= fmtScore(score.geo) %></span></td>
    </tr>
  </tbody>
</table>
</div>

<% if (!hasPageScores) { %>
  <p class="muted">Détail par page indisponible (run antérieur à l'ajout du score par page). Seul le score site agrégé est affiché.</p>
<% } %>
<% } %>

<% if (cnPages.length) { %>
  <h2>Synthèse — pages China</h2>
  <p class="muted">
    Sur une page China, chaque sujet est réduit à son <strong>premier critère</strong> (0 ou 100)
    et le sujet 12 « China Market Access » n'est mesuré que là.
  </p>
  <%
    var hasCnScores = hasScores(cnPages);
  %>
  <div class="scroll-x">
  <table class="grid small">
    <thead>
      <tr>
        <th></th>
        <% if (hasCnScores) { cnPages.forEach(function(p){ %><th title="<%= p.url %>"><%= p.label %></th><% }); } %>
        <th>Site</th>
      </tr>
    </thead>
    <tbody>
      <%# The final China score: topic 12, which folds the fundamentals below into 50 of its points. %>
      <tr>
        <td><strong>China Market Access</strong></td>
        <% if (hasCnScores) { cnPages.forEach(function(p){ %>
          <td><span class="score sm <%= scoreClass(p.china) %>"><%= fmtScore(p.china) %></span></td>
        <% }); } %>
        <td><span class="score <%= scoreClass(score.china) %>"><%= fmtScore(score.china) %></span> <% provisional(cnPending) %></td>
      </tr>
      <tr>
        <td class="muted">dont fondamentaux sitespeed (sujets 1–10, 1er critère) — 50 pts du score ci-dessus</td>
        <% if (hasCnScores) { cnPages.forEach(function(p){ %>
          <td><span class="score sm <%= scoreClass(p.overall) %>"><%= fmtScore(p.overall) %></span></td>
        <% }); } %>
        <td><span class="score sm <%= scoreClass(score.chinaOverall) %>"><%= fmtScore(score.chinaOverall) %></span></td>
      </tr>
    </tbody>
  </table>
  </div>
<% } %>

<%
  // One topic block (site column + per-page columns), reused by both families.
  function renderTopics(topicList, familyPages) {
    var hasCols = hasScores(familyPages);
%>
  <% (topicList || []).forEach(function(t){ %>
    <h3><%= t.topicId %>. <%= t.name %> —
      <span class="score <%= scoreClass(t.score) %>"><%= fmtScore(t.score) %><% if (t.score !== null){ %>/100<% } %></span>
    </h3>
    <% if (t.score === null) { %>
      <p class="muted">N/A — aucun critère applicable.</p>
    <% } else { %>
      <div class="scroll-x">
      <table class="grid small crit">
        <thead>
          <tr>
            <th>Critère</th>
            <% if (hasCols) { familyPages.forEach(function(p){ %><th title="<%= p.url %>"><%= p.label %></th><% }); } %>
            <th>Site (pts)</th>
            <th>Évidence</th>
          </tr>
        </thead>
        <tbody>
          <tr class="topic-row">
            <td><strong>Score topic</strong></td>
            <% if (hasCols) { familyPages.forEach(function(p){ var pt = pTopic(p, t.topicId); %>
              <td><span class="score sm <%= scoreClass(pt ? pt.score : null) %>"><%= pt ? fmtScore(pt.score) : '—' %></span></td>
            <% }); } %>
            <td><span class="score sm <%= scoreClass(t.score) %>"><%= fmtScore(t.score) %></span></td>
            <td></td>
          </tr>
          <% (t.controls || []).forEach(function(c){ %>
            <tr>
              <td><%= c.label %></td>
              <% if (hasCols) { familyPages.forEach(function(p){
                   var pc = pCtrl(pTopic(p, t.topicId), c.controlId);
                   var cur = !pc ? '' : (!pc.applicable ? 'na' : (pc.passed ? 'pass' : 'fail'));
              %>
                <td class="verdict-cell">
                  <% if (!pc) { %><span class="muted">—</span>
                  <% } else if (isDerived(c.controlId)) { %>
                    <%# Derived from the other topics: displayed, never editable. %>
                    <% if (!pc.applicable) { %><span class="muted">N/A</span>
                    <% } else { %><span class="muted" title="<%= pc.evidence %>"><%= pc.pointsAwarded %>/<%= pc.maxPoints %></span><% } %>
                  <% } else { %>
                    <% if (isPending(pc)) { %><span class="unknown-flag" title="À confirmer — le contrôle n'a pas pu mesurer ; compté comme échec en attendant">?</span><% } %>
                    <select class="verdict <%= cur %><%= pc.manual ? ' manual' : '' %><%= isPending(pc) ? ' unknown' : '' %>"
                            data-current="<%= cur %>"
                            title="<%= pc.manual ? 'Corrigé manuellement — ' : '' %><%= pc.evidence %>"
                            onchange="critEdit(this, <%= score.runId %>, <%= p.runPageId %>, '<%= c.controlId %>', this.value)">
                      <option value="pass" <%= cur === 'pass' ? 'selected' : '' %>>✓</option>
                      <option value="fail" <%= cur === 'fail' ? 'selected' : '' %>>✗</option>
                      <option value="na" <%= cur === 'na' ? 'selected' : '' %>>N/A</option>
                      <% if (pc.auto) { %><option value="auto">↺ mesuré</option><% } %>
                    </select>
                    <% if (pc.manual) { %><span class="manual-flag" title="Corrigé manuellement">✏️</span><% } %>
                  <% } %>
                </td>
              <% }); } %>
              <td>
                <% if (c.applicable) { %><%= c.pointsAwarded %>/<%= c.maxPoints %><% if (isPending(c)) { %><span class="unknown-flag" title="À confirmer sur au moins une page">?</span><% } %>
                <% } else { %><span class="muted">N/A</span><% } %>
              </td>
              <td class="ev">
                <% if (hasCols) { familyPages.forEach(function(p){ var pc = pCtrl(pTopic(p, t.topicId), c.controlId); %>
                  <div><span class="muted"><%= p.label %>:</span>
                    <% if (!pc || !pc.applicable) { %>N/A<% } else { %><%= pc.evidence %><% } %>
                  </div>
                <% }); } else { %>—<% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    <% } %>
  <% }) %>
<%
  }
%>

<% if (stdPages.length) { %>
  <h2>Détail par sujet<% if (cnPages.length) { %> — pages hors China<% } %></h2>
  <% renderTopics(topics, stdPages) %>
<% } %>

<% if (cnTopics) { %>
  <h2>Détail par sujet — pages China</h2>
  <% renderTopics(cnTopics, cnPages) %>
<% } %>

<%- include('partials/footer') %>
