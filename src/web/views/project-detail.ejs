<%- include('partials/header', { title, active }) %>

<p><a href="/projects">← Projects</a></p>
<h1><%= project.name %> <% if (project.mode === 'MONITORING') { %><span class="badge b-monitor">Suivi webperf</span><% } %></h1>
<p class="muted"><% if (project.client) { %>Client : <strong><%= project.client.name %></strong><% } else { %><span>Sans client</span><% } %><% if (project.description) { %> · <%= project.description %><% } %></p>

<% if (flash === 'crux_started') { %>
  <div class="flash ok">Cycle de suivi lancé : CrUX collecté et run démarré.</div>
<% } else if (flash === 'busy') { %>
  <div class="flash warn">Un run est déjà en cours — réessayez une fois qu'il est terminé.</div>
<% } %>

<section>
  <h2>Évolution des notes</h2>
  <% if (trend) { %>
    <div class="chart-card">
      <svg class="trend" viewBox="0 0 <%= trend.width %> <%= trend.height %>" role="img"
           aria-label="Évolution de la note globale et des pages par run">
        <!-- horizontal gridlines + y-axis labels -->
        <% trend.yTicks.forEach(function(t){ %>
          <line class="grid" x1="<%= trend.pad.l %>" y1="<%= t.y %>"
                x2="<%= trend.width - trend.pad.r %>" y2="<%= t.y %>"></line>
          <text class="axis" x="<%= trend.pad.l - 6 %>" y="<%= t.y + 3 %>" text-anchor="end"><%= t.value %></text>
        <% }) %>
        <!-- x-axis run labels -->
        <% trend.xLabels.forEach(function(x){ %>
          <text class="axis" x="<%= x.x %>" y="<%= trend.height - trend.pad.b + 16 %>" text-anchor="middle"><%= x.label %></text>
        <% }) %>
        <!-- one polyline + markers per series -->
        <% trend.series.forEach(function(s){ %>
          <% if (s.path) { %>
            <path d="<%= s.path %>" fill="none" stroke="<%= s.color %>"
                  stroke-width="<%= s.isGlobal ? 3 : 1.8 %>"
                  stroke-linejoin="round" stroke-linecap="round"></path>
          <% } %>
          <% s.points.forEach(function(p){ %>
            <circle cx="<%= p.cx %>" cy="<%= p.cy %>" r="<%= s.isGlobal ? 4 : 3 %>" fill="<%= s.color %>">
              <title><%= p.title %></title>
            </circle>
          <% }) %>
        <% }) %>
      </svg>
      <div class="chart-legend">
        <% trend.series.forEach(function(s){ %>
          <span class="lg<%= s.isGlobal ? ' lg-strong' : '' %>">
            <span class="swatch" style="background: <%= s.color %>"></span><%= s.label %>
          </span>
        <% }) %>
      </div>
    </div>
  <% } else { %>
    <p class="empty">Aucun run terminé pour le moment — lancez un run pour voir l’évolution des notes.</p>
  <% } %>
</section>

<% if (project.mode === 'MONITORING') { %>
<section>
  <h2>Suivi webperf</h2>
  <div class="two-col">
    <div>
      <form method="post" action="/projects/<%= project.id %>/monitoring" class="run-form">
        <label>Mode
          <select name="mode">
            <option value="MONITORING" selected>Suivi webperf (récurrent)</option>
            <option value="STANDARD">Standard (désactiver le suivi)</option>
          </select>
        </label>
        <label>Fréquence
          <select name="monitorFrequency">
            <option value="DAILY" <%= project.monitorFrequency === 'DAILY' ? 'selected' : '' %>>Quotidien</option>
            <option value="WEEKLY" <%= project.monitorFrequency === 'WEEKLY' ? 'selected' : '' %>>Hebdomadaire</option>
          </select>
        </label>
        <button type="submit" class="btn">Enregistrer</button>
      </form>
      <p class="muted small">
        Prochain cycle : <% if (project.monitorNextAt) { %><%= fmtDate(project.monitorNextAt) %><% } else { %>—<% } %>
        · Dernier : <% if (project.monitorLastAt) { %><%= fmtDate(project.monitorLastAt) %><% } else { %>jamais<% } %>
      </p>
    </div>
    <div>
      <form method="post" action="/projects/<%= project.id %>/monitor-now">
        <button type="submit" class="btn-primary">⟳ Collecter maintenant</button>
      </form>
      <p class="muted small">Collecte CrUX immédiate + lancement d'un run de maturité.</p>
    </div>
  </div>

  <div class="ff-toggle">
    <a class="ff-tab <%= selectedFF === 'PHONE' ? 'active' : '' %>" href="/projects/<%= project.id %>?ff=PHONE">📱 Mobile</a>
    <a class="ff-tab <%= selectedFF === 'DESKTOP' ? 'active' : '' %>" href="/projects/<%= project.id %>?ff=DESKTOP">🖥 Desktop</a>
    <% if (cruxFormFactors && cruxFormFactors.length && !cruxFormFactors.includes(selectedFF)) { %>
      <span class="muted small">Aucune donnée <%= selectedFF === 'DESKTOP' ? 'desktop' : 'mobile' %> pour l'instant.</span>
    <% } %>
  </div>

  <h3>Dernières valeurs CrUX (terrain, <%= selectedFF === 'DESKTOP' ? 'desktop' : 'mobile' %>)</h3>
  <% if (cruxLatest && cruxLatest.length) { %>
    <table class="grid small">
      <thead><tr><th>Périmètre</th><th>LCP</th><th>TTFB</th><th>INP</th><th>CLS</th><th>FCP</th><th>Relevé</th></tr></thead>
      <tbody>
        <% cruxLatest.forEach(function(c){ %>
          <tr>
            <td><%= c.label %></td>
            <td><% if (c.lcpMs != null) { %><%= (c.lcpMs/1000).toFixed(2) %> s<% } else { %>—<% } %></td>
            <td><% if (c.ttfbMs != null) { %><%= c.ttfbMs %> ms<% } else { %>—<% } %></td>
            <td><% if (c.inpMs != null) { %><%= c.inpMs %> ms<% } else { %>—<% } %></td>
            <td><% if (c.cls != null) { %><%= c.cls.toFixed(2) %><% } else { %>—<% } %></td>
            <td><% if (c.fcpMs != null) { %><%= (c.fcpMs/1000).toFixed(2) %> s<% } else { %>—<% } %></td>
            <td class="muted"><%= fmtDate(c.collectedAt) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p class="empty">Aucune donnée CrUX collectée pour le moment.</p>
  <% } %>

  <% if (cruxTrends && cruxTrends.length) { %>
    <h3>Tendances CrUX (<%= selectedFF === 'DESKTOP' ? 'desktop' : 'mobile' %>)</h3>
    <% cruxTrends.forEach(function(chart){ %>
      <div class="chart-card">
        <h4 class="chart-title"><%= chart.label %></h4>
        <svg class="trend" viewBox="0 0 <%= chart.width %> <%= chart.height %>" role="img"
             aria-label="Tendance <%= chart.label %>">
          <% chart.yTicks.forEach(function(t){ %>
            <line class="grid" x1="<%= chart.pad.l %>" y1="<%= t.y %>"
                  x2="<%= chart.width - chart.pad.r %>" y2="<%= t.y %>"></line>
            <text class="axis" x="<%= chart.pad.l - 6 %>" y="<%= t.y + 3 %>" text-anchor="end"><%= t.label %></text>
          <% }) %>
          <% chart.xLabels.forEach(function(x){ %>
            <text class="axis" x="<%= x.x %>" y="<%= chart.height - chart.pad.b + 16 %>" text-anchor="middle"><%= x.label %></text>
          <% }) %>
          <% chart.series.forEach(function(s){ %>
            <% if (s.path) { %>
              <path d="<%= s.path %>" fill="none" stroke="<%= s.color %>"
                    stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"></path>
            <% } %>
            <% s.points.forEach(function(p){ %>
              <circle cx="<%= p.cx %>" cy="<%= p.cy %>" r="3" fill="<%= s.color %>">
                <title><%= p.title %></title>
              </circle>
            <% }) %>
          <% }) %>
        </svg>
        <div class="chart-legend">
          <% chart.series.forEach(function(s){ %>
            <span class="lg"><span class="swatch" style="background: <%= s.color %>"></span><%= s.label %></span>
          <% }) %>
        </div>
      </div>
    <% }) %>
  <% } %>
</section>
<% } %>

<div class="two-col">
  <section>
    <h2>Lancer un run</h2>
    <form method="post" action="/projects/<%= project.id %>/run" class="run-form">
      <label>Navigateur
        <select name="browser">
          <option value="cloak">CloakBrowser (anti-bot, recommandé)</option>
          <option value="playwright">Playwright (headless)</option>
          <option value="cdp">Chrome réel (CDP — anti-bot max, ouvre une fenêtre)</option>
        </select>
      </label>
      <p class="muted small">En cas d'échec ou de capture bloquée, les autres navigateurs sont
        automatiquement réessayés (cloak → playwright → chrome réel).</p>
      <label>Device
        <select name="device">
          <option value="mobile">Mobile</option>
          <option value="desktop">Desktop</option>
        </select>
      </label>
      <label class="chk"><input type="checkbox" name="acceptCookies" checked> Accepter les cookies</label>
      <button type="submit" class="btn-primary" <%= project.pages.length ? '' : 'disabled' %>>▶ Lancer (<%= project.pages.length %> pages)</button>
    </form>

    <h2>Pages (<%= project.pages.length %>)</h2>
    <table class="grid small">
      <tbody>
        <% project.pages.forEach(function(pp){ %>
          <tr>
            <td><span class="badge"><%= pp.page.kind %></span></td>
            <td><%= pp.page.site.name %></td>
            <td class="url"><%= pp.page.url %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>

  <section>
    <h2>Runs de ce projet</h2>
    <table class="grid">
      <thead><tr><th>#</th><th>Statut</th><th>Source</th><th>Date</th></tr></thead>
      <tbody>
        <% project.runs.forEach(function(r){ %>
          <tr>
            <td><a href="/runs/<%= r.id %>">#<%= r.id %></a></td>
            <td><span class="badge b-<%= r.status %>"><%= r.status %></span></td>
            <td class="muted"><%= r.source === 'scheduled' ? 'Planifié' : 'Manuel' %></td>
            <td><%= fmtDate(r.createdAt) %></td>
          </tr>
        <% }) %>
        <% if (!project.runs.length) { %><tr><td colspan="4" class="muted">Aucun run encore.</td></tr><% } %>
      </tbody>
    </table>
  </section>
</div>

<%- include('partials/footer') %>
