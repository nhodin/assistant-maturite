<%
  var r = (typeof result !== 'undefined' && result) ? result : { sites: [], rejected: [], duplicates: [], counts: { urls: 0, sites: 0, rejected: 0, duplicates: 0 } };
  var dups = r.duplicates || [];
  // PDP/PLP search asked for on the creation form (empty elsewhere).
  var kinds = (typeof discoveryKinds !== 'undefined' && discoveryKinds) ? discoveryKinds : [];
  // Helpers reach EJS through viewHelpers, loaded at boot while views reload per
  // request: a server started before they existed must still render the preview.
  var startOf = typeof discoveryStartUrl === 'function' ? discoveryStartUrl : function(){ return null; };
  var isHome = typeof isHomeLikeUrl === 'function' ? isHomeLikeUrl : function(){ return false; };
%>
<div class="preview-box">
  <p class="preview-summary">
    <strong><%= r.counts.urls %></strong> URL<%= r.counts.urls > 1 ? 's' : '' %> →
    <strong><%= r.counts.sites %></strong> site<%= r.counts.sites > 1 ? 's' : '' %>,
    <strong><%= r.counts.rejected %></strong> rejet<%= r.counts.rejected > 1 ? 's' : '' %><% if (dups.length) { %>,
    <strong><%= dups.length %></strong> doublon<%= dups.length > 1 ? 's' : '' %> fusionné<%= dups.length > 1 ? 's' : '' %><% } %>
  </p>
  <% if (r.sites.length) { %>
    <ul class="preview-sites">
      <% r.sites.forEach(function(s){ %>
        <li>
          <strong><%= s.site %></strong>
          <span class="muted">— <%= s.pages.length %> page<%= s.pages.length > 1 ? 's' : '' %></span>
          <% var start = kinds.length ? startOf(s.pages) : null; if (start) { %>
            <div class="muted small">+ <%= kinds.join(' + ') %> à rechercher depuis <span class="url-inline"><%= start %></span></div>
          <% } %>
          <details>
            <summary>voir les URLs</summary>
            <ul class="preview-urls">
              <% s.pages.forEach(function(u){ %><li class="url"><% if (isHome(u)) { %><span class="badge">HP</span> <% } %><%= u %></li><% }) %>
            </ul>
          </details>
        </li>
      <% }) %>
    </ul>
  <% } %>
  <% if (dups.length) { %>
    <details class="preview-dups">
      <summary>Doublons fusionnés (même page écrite autrement)</summary>
      <ul class="preview-urls">
        <% dups.forEach(function(d){ %><li class="url"><code><%= d.line %></code> = <%= d.duplicateOf %></li><% }) %>
      </ul>
    </details>
  <% } %>
  <% if (r.rejected.length) { %>
    <p class="warn">URLs rejetées (ignorées) :</p>
    <ul class="preview-rejects">
      <% r.rejected.forEach(function(x){ %><li><code><%= x.line %></code> — <%= x.reason %></li><% }) %>
    </ul>
  <% } %>
  <% if (!r.sites.length && !r.rejected.length) { %>
    <p class="muted">Collez des URLs ci-dessus pour voir l'aperçu.</p>
  <% } %>
</div>
