<%- include('partials/header', { title, active }) %>

<%
  var TCOLS = [
    {id:1,ab:'Img'},{id:2,ab:'Sld'},{id:3,ab:'Vid'},{id:4,ab:'3P'},{id:5,ab:'TTFB'},
    {id:6,ab:'JS'},{id:7,ab:'CSS'},{id:8,ab:'CP'},{id:9,ab:'Fnt'},{id:10,ab:'CDN'}
  ];
  function tScore(topics, id){ var t=(topics||[]).find(function(x){return x.topicId===id}); return t? t.score : undefined; }
%>

<p><a href="/runs">← Runs</a></p>
<div class="head-row">
  <h1>Run #<%= run.id %></h1>
  <span class="badge b-<%= run.status %>"><%= run.status %></span>
  <% if (!isLive && pendingPages > 0) { %>
    <form method="post" action="/runs/<%= run.id %>/resume">
      <% if (run.status === 'DONE') { %>
        <%# The run went to the end: what is left is pages that failed to capture. %>
        <button class="btn" type="submit">↻ Relancer <%= pendingPages %> page<%= pendingPages > 1 ? 's' : '' %> en échec</button>
      <% } else { %>
        <button class="btn" type="submit">▶ Reprendre (<%= pendingPages %> page<%= pendingPages > 1 ? 's' : '' %>)</button>
      <% } %>
    </form>
  <% } %>
  <%# Audience (CrUX popularity) depends on the origin only: computable on a
      stored run without recapturing a single page. %>
  <% if (!isLive && isDiagRun) { %>
    <form method="post" action="/runs/<%= run.id %>/audience">
      <button class="btn" type="submit" title="Calcule (ou rafraîchit) la colonne Audience — rang CrUX FR/monde et part mobile — sans recapturer les pages">📊 Calculer l'audience</button>
    </form>
  <% } %>
</div>
<% if (flash) { %><div class="empty err"><%= flash %></div><% } %>
<p class="muted">
  Projet « <%= run.project.name %> » · <%= run.browser %> · <%= run.device %> ·
  <%= fmtDate(run.startedAt) %> → <%= fmtDate(run.finishedAt) %>
</p>
<% if (run.error) { %><div class="empty err"><%= run.error %></div><% } %>
<%# Non-blocking: the run is complete, one informational column is not. %>
<% if (run.warning) { %><div class="flash warn"><%= run.warning %></div><% } %>

<% if (isLive) { %>
  <%- include('partials/run-progress', { run }) %>
<% } else { %>
  <% if (pendingPages > 0 && run.runPages.length) { %>
    <p class="muted">
      <%= run.runPages.length - pendingPages %>/<%= run.runPages.length %> pages capturées.
      <% if (run.status === 'DONE') { %>
        Relancer ne recapture que les <%= pendingPages %> page(s) en échec et recalcule les
        sites concernés ; les pages réussies sont conservées.
      <% } else { %>
        « Reprendre » ne recapture que les pages manquantes ; les pages déjà capturées sont conservées.
      <% } %>
    </p>
  <% } %>

  <% if (isDiagRun) { %>
    <div class="head-row">
      <h2>Diagnostic Speed/SEO</h2>
      <% if (run.status === 'DONE' && run.runPages.length) { %>
        <a class="btn" href="/runs/<%= run.id %>/export.csv"
           title="Une ligne par page : verdicts, mesures, divergence, techno et évidences">⬇ Export CSV</a>
      <% } %>
    </div>

    <%# A verdict scored by rules that have since changed looks exactly like a
        fresh one. Saying so is the whole point — the alternative is trusting it. %>
    <% if (typeof diagRules !== "undefined" && diagRules && diagRules.freshness !== "current") { %>
      <% if (diagRules.freshness === "stale") { %>
        <div class="flash warn rules-stale">
          ⚠ Ces résultats ont été produits par une <strong>version antérieure des règles de
          détection</strong> (<code><%= diagRules.stored %></code> ; version actuelle
          <code><%= diagRules.current %></code>). Les verdicts affichés ne reflètent pas les
          critères en vigueur — relancer le run pour les mettre à jour.
          <% if (run.status === 'DONE') { %>
            Si le serveur a été mis à jour sans redémarrage, le redémarrer d'abord.
          <% } %>
        </div>
      <% } else { %>
        <div class="flash rules-unknown">
          Version des règles de détection <strong>inconnue</strong> pour ce run — il est
          antérieur au suivi de version. Ses verdicts peuvent avoir été produits par des
          critères différents de ceux en vigueur.
        </div>
      <% } %>
    <% } %>
    <p class="muted">
      Pas de score de maturité : chaque page reçoit un verdict EdgeSpeed / EdgeSEO
      catégoriel (GO / NOGO / à confirmer). Un site dont les pages ne sont pas
      d'accord est marqué « divergent » : une PDP pèse plus qu'une home en volume
      d'optimisation.
      <% if (diagPending) { %><span class="provisional" title="Ces checks comptent comme échec tant qu'ils ne sont pas arbitrés">provisoire — <%= diagPending %> check<%= diagPending > 1 ? 's' : '' %> à confirmer</span><% } %>
    </p>

    <%- include("partials/diag-verdict-rule") %>
    <% if (!diagSites.length) { %><p class="muted">Aucun site diagnostiqué.</p><% } %>
    <%- include('partials/diag-page-table', { run: run }) %>
  <% } else { %>
  <div class="head-row">
    <h2>Classement global</h2>
    <% if (run.status === 'DONE' && ranking.length) { %>
      <a class="btn" href="/runs/<%= run.id %>/export.csv">⬇ Export CSV</a>
    <% } %>
  </div>
  <div class="scroll-x">
  <table class="grid matrix">
    <thead>
      <tr><th>#</th><th>Site</th><th>Cat.</th>
        <% TCOLS.forEach(function(c){ %><th title="topic <%= c.id %>"><%= c.ab %></th><% }) %>
        <th>Global</th><th>GEO</th><th title="Sujet 12 — China Market Access, le score China final (pages China uniquement)">China</th><th title="Dont fondamentaux sitespeed : sujets 1-10 sur leur 1er critère — vaut 50 pts du score China">dont base</th></tr>
    </thead>
    <tbody>
      <% ranking.forEach(function(s, i){ %>
        <tr>
          <td><%= i+1 %></td>
          <td><a href="/runs/<%= run.id %>/sites/<%= s.siteId %>"><%= s.site.name %></a></td>
          <td class="muted"><%= categoryLabel(s.category) %></td>
          <% TCOLS.forEach(function(c){ var v=tScore(s.topicsJson, c.id); %>
            <td><span class="score sm <%= scoreClass(v) %>"><%= fmtScore(v) %></span></td>
          <% }) %>
          <%# A score with unmeasured criteria is provisional: they count as failures for now. %>
          <% var sPending = (typeof pendingBySite !== 'undefined' && pendingBySite) ? (pendingBySite[s.siteId] || 0) : 0; %>
          <td><span class="score <%= scoreClass(s.overall) %>"><%= fmtScore(s.overall) %></span><% if (sPending) { %><span class="provisional-mark" title="Score provisoire — <%= sPending %> critère(s) à confirmer">?</span><% } %></td>
          <td><span class="score <%= scoreClass(s.geo) %>"><%= fmtScore(s.geo) %></span></td>
          <td><span class="score <%= scoreClass(s.china) %>"><%= fmtScore(s.china) %></span></td>
          <td><span class="score sm <%= scoreClass(s.chinaOverall) %>"><%= fmtScore(s.chinaOverall) %></span></td>
        </tr>
      <% }) %>
      <% if (!ranking.length) { %><tr><td colspan="17" class="muted">Aucun score (toutes les pages ont échoué ?).</td></tr><% } %>
    </tbody>
  </table>
  </div>

  <%# A site whose every page failed has no aggregate, so it is nowhere in the
      ranking above. Its per-site page still opens: that is where its criteria
      are graded by hand, and the first verdict puts it back in the classement. %>
  <% var unscored = (typeof unscoredSites !== 'undefined' && unscoredSites) ? unscoredSites : []; %>
  <% if (unscored.length) { %>
    <p class="muted note">
      <strong>Sans score :</strong>
      <% unscored.forEach(function(site, i){ %><%= i ? ' · ' : '' %><a href="/runs/<%= run.id %>/sites/<%= site.id %>"><%= site.name %></a><% }) %>
      — aucune de leurs pages n'a pu être capturée. Ouvrir le site permet d'en saisir
      les verdicts à la main ; le premier saisi le fait entrer dans le classement.
    </p>
  <% } %>
  <% } %>

  <%# Capture des pages — redundant on a diag run: the diagnostic table above
      already carries the site, the URL, the status and the capture errors. Kept
      for maturity runs, where the scoring tables carry none of that. %>
  <% if (!isDiagRun) { %>
  <h2>Capture des pages</h2>
  <table class="grid small">
    <thead><tr><th>Site</th><th>Type</th><th>URL</th><th>Statut</th></tr></thead>
    <tbody>
      <%# Pages arrive grouped by site (routes/runs.ts:sortRunPagesBySite): the
          name is written once per group, and a rule separates one site from the next. %>
      <% var prevSite = null; %>
      <% run.runPages.forEach(function(rp){ var first = rp.page.siteId !== prevSite; prevSite = rp.page.siteId; %>
        <tr class="<%= first ? 'site-start' : 'site-cont' %>">
          <td><% if (first) { %><a href="/runs/<%= run.id %>/sites/<%= rp.page.siteId %>"><%= rp.page.site.name %></a><% } %></td>
          <td><span class="badge<%= rp.page.kind === 'CHINA' ? ' b-china' : '' %>"><%= rp.page.kind %></span></td>
          <td class="url"><%= rp.url %></td>
          <td><span class="badge b-<%= rp.status %>"><%= rp.status %></span></td>
        </tr>
        <% if (rp.error) { %>
          <tr class="note-row">
            <td colspan="4" class="ev <%= rp.status === 'FAILED' ? 'ko' : 'muted' %>">
              <span class="note-for"><%= rp.page.site.name %> · <%= rp.page.kind %> —</span>
              <%= rp.error %>
            </td>
          </tr>
        <% } %>
      <% }) %>
    </tbody>
  </table>
  <% } %>

<% } %>

<%- include('partials/footer') %>
