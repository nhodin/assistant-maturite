<%- include('partials/header', { title, active }) %>

<h1>Runs</h1>
<% if (activeRunId) { %><p class="muted">Run actif : <a href="/runs/<%= activeRunId %>">#<%= activeRunId %></a> en cours…</p><% } %>

<%- include('partials/client-filter', { clients, selectedClientId, basePath: '/runs' }) %>

<table class="grid">
  <thead><tr><th>#</th><th>Client</th><th>Projet</th><th>Statut</th><th>Pages</th><th>Sites notés</th><th>Date</th><th></th></tr></thead>
  <tbody>
    <% runs.forEach(function(r){ %>
      <tr>
        <td><a href="/runs/<%= r.id %>">#<%= r.id %></a></td>
        <td><% if (r.project.client) { %><%= r.project.client.name %><% } else { %><span class="muted">—</span><% } %></td>
        <td><%= r.project.name %></td>
        <td><span class="badge b-<%= r.status %>"><%= r.status %></span></td>
        <%# donePages counts failures too, so a run can read 30/30 with pages missing. %>
        <td>
          <%= r.donePages %>/<%= r.totalPages %>
          <% var ko = pendingByRun.get(r.id) || 0; %>
          <% if (ko > 0 && r.status === 'DONE') { %><span class="badge b-FAILED"><%= ko %> KO</span><% } %>
        </td>
        <td><%= r._count.runSiteScores %></td>
        <td><%= fmtDate(r.createdAt) %></td>
        <td class="actions">
          <% var left = pendingByRun.get(r.id) || 0; %>
          <% if (left > 0 && activeRunId !== r.id) { %>
            <form method="post" action="/runs/<%= r.id %>/resume">
              <% if (r.status === 'DONE') { %>
                <button type="submit" title="Recapture les <%= left %> page(s) en échec">↻ Relancer les échecs</button>
              <% } else { %>
                <button type="submit" title="<%= left %> page(s) restant à capturer">▶ Reprendre</button>
              <% } %>
            </form>
          <% } %>
          <form method="post" action="/runs/<%= r.id %>/delete" onsubmit="return confirm('Supprimer ce run ?')">
            <button class="danger" type="submit">Suppr.</button>
          </form>
        </td>
      </tr>
    <% }) %>
    <% if (!runs.length) { %><tr><td colspan="8" class="muted">Aucun run.</td></tr><% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
