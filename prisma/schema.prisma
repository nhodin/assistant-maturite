// Maturity Analyzer — persistence schema (MySQL).
// Inventory (Site/Page) → Project (selection of pages) → Run (one execution) →
// RunPage (per-page evidence) + RunSiteScore (aggregated per-site results).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// LVMH maisons categories used for global + per-category ranking.
enum Category {
  Beauty
  Fragrances
  WatchesJewelry // Watches & Jewelry
  WineSpirits // Wine & Spirits
  SR
  Other
}

enum PageKind {
  HP
  PLP
  PDP
  OTHER
}

enum RunStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Whether a project is a one-off (STANDARD) or a recurring webperf monitor.
enum ProjectMode {
  STANDARD
  MONITORING
}

/// How often a MONITORING project re-runs its cycle.
enum MonitorFrequency {
  DAILY
  WEEKLY
}

/// Scope of a CrUX field-data snapshot: an origin or a specific page URL.
enum CruxScope {
  ORIGIN
  PAGE
}

/// Device form factor of a CrUX field-data snapshot. Mobile and desktop are
/// tracked separately (each cycle samples both).
enum CruxFormFactor {
  PHONE
  DESKTOP
}

/// A client / organization that owns sites and projects (e.g. LVMH, Conforama, Groupama).
model Client {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites    Site[]
  projects Project[]
}

/// A website in the inventory. Has one category and one or more pages.
model Site {
  id        Int      @id @default(autoincrement())
  name      String
  category  Category @default(Other)
  homepage  String?  @db.Text
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Owning client. Nullable in DB (so existing rows survive `db push`); the UI always
  // requires one. Deleting a client detaches its sites rather than cascading.
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId Int?

  pages         Page[]
  runSiteScores RunSiteScore[]

  @@index([clientId])
}

/// A specific page (URL) of a site to audit.
model Page {
  id        Int      @id @default(autoincrement())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId    Int
  kind      PageKind @default(OTHER)
  label     String?
  url       String   @db.Text
  createdAt DateTime @default(now())

  projectPages  ProjectPage[]
  runPages      RunPage[]
  cruxSnapshots CruxSnapshot[]

  @@index([siteId])
}

/// A campaign / iteration grouping a selection of pages to test repeatedly.
model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  // Owning client (nullable in DB, required in the UI; see Site.clientId).
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId Int?

  // Webperf monitoring ("suivi webperf"). STANDARD projects only run on demand;
  // MONITORING projects are re-run + CrUX-sampled by the scheduler on a frequency.
  mode             ProjectMode      @default(STANDARD)
  monitorFrequency MonitorFrequency @default(DAILY)
  monitorNextAt    DateTime? // when the next cycle is due (null = never scheduled)
  monitorLastAt    DateTime? // when the last cycle actually executed
  monitorPaused    Boolean          @default(false) // paused → the scheduler skips this project

  pages         ProjectPage[]
  runs          Run[]
  cruxSnapshots CruxSnapshot[]

  @@index([clientId])
}

/// A CrUX field-data sample for a monitored project, taken at a point in time.
/// One row per (origin | page URL) per collection cycle. Only inserted when CrUX
/// returned data (no all-null rows).
model CruxSnapshot {
  id          Int       @id @default(autoincrement())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int
  scope       CruxScope
  // Device form factor this sample was collected for (mobile vs desktop).
  // Defaults to PHONE so pre-existing rows (all mobile) stay valid without a data migration.
  formFactor  CruxFormFactor @default(PHONE)
  // For PAGE scope, the page this sample belongs to. Null for ORIGIN scope.
  page        Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId      Int?
  urlKey      String    @db.Text // the origin or page URL queried
  lcpMs       Int?
  ttfbMs      Int?
  inpMs       Int?
  cls         Float?
  fcpMs       Int?
  collectedAt DateTime  @default(now())

  @@index([projectId, collectedAt])
  @@index([pageId])
}

/// Join: which pages are included in a project.
model ProjectPage {
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  page      Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    Int

  @@id([projectId, pageId])
  @@index([pageId])
}

/// One execution of a project's pages at a point in time.
model Run {
  id            Int       @id @default(autoincrement())
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     Int
  status        RunStatus @default(PENDING)
  browser       String    @default("cloak") // playwright | cloak | cdp
  source        String    @default("manual") // manual | scheduled
  device        String    @default("mobile")
  acceptCookies Boolean   @default(true)
  configJson    Json? // snapshot of the control config used for this run
  totalPages    Int       @default(0)
  donePages     Int       @default(0)
  error         String?   @db.Text
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())

  runPages      RunPage[]
  runSiteScores RunSiteScore[]

  @@index([projectId])
}

/// Per-page capture + status within a run. Stores the full EvidenceBundle
/// and the per-page score (each criterion binary: full points or 0).
model RunPage {
  id           Int       @id @default(autoincrement())
  run          Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId        Int
  page         Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId       Int
  url          String    @db.Text
  status       RunStatus @default(PENDING)
  evidenceJson Json? // captured EvidenceBundle (large)
  // Per-page scores. Null on legacy runs captured before per-page scoring existed.
  overall      Int?
  geo          Int?
  china        Int?
  topicsJson   Json? // TopicResult[] for this single page
  error        String?   @db.Text
  createdAt    DateTime  @default(now())

  @@index([runId])
  @@index([pageId])
}

/// Aggregated per-site result for a run (used for ranking + detail).
model RunSiteScore {
  id         Int      @id @default(autoincrement())
  run        Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId      Int
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId     Int
  category   Category
  overall    Int?
  geo        Int?
  china      Int?
  topicsJson Json // TopicResult[] (per-topic scores + control evidence)

  @@unique([runId, siteId])
  @@index([runId])
}

/// Editable per-control configuration (Settings UI). Keyed by control id.
model ControlConfig {
  controlId      String   @id
  enabled        Boolean  @default(true)
  pointsOverride Int?
  naForced       Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}
