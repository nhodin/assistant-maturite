# Copy to .env and adjust. Used by Prisma (DATABASE_URL) and the web server (PORT).
DATABASE_URL="mysql://maturite:maturite@127.0.0.1:3306/maturite"
PORT=5173

CRUX_API_KEY=xxxxxxxx

CAPTURE_CONCURRENCY=2

# Optional — only needed for `npm run spike:cloudflare` (Cloudflare Browser Run
# feasibility spike). API token needs "Browser Rendering - Edit" permission.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# ── CloakBrowser Pro (provider `--browser cloak`) ────────────────────────────
# Colle ta clé de licence ici : c'est la SEULE chose à faire pour activer le Pro.
# Le binaire stealth lit lui-même cette variable ; elle peut aussi vivre dans
# ~/.cloakbrowser/license.key
CLOAKBROWSER_LICENSE_KEY=cb_xxxxxxxx

# Optionnel — proxy résidentiel (http, https ou socks5), identifiants inclus.
# CLOAK_PROXY=http://user:pass@residential-host:port

# Optionnel — aligne timezone/locale sur l'IP du proxy. Nécessite `npm i mmdb-lib`
# et n'a d'effet que si CLOAK_PROXY est défini.
# CLOAK_GEOIP=1

# Optionnel — émulation souris/clavier humaine. Défauts : activée, preset careful.
# CLOAK_HUMANIZE=1
# CLOAK_HUMAN_PRESET=careful

# Optionnel — la capture démarre en headless (recommandé par l'éditeur : le mode
# headed est l'ESCALADE après un blocage, pas le point de départ). Mettre 0 pour
# forcer le headed dès la première tentative. La 2e tentative passe en headed
# quoi qu'il arrive.
# CLOAK_HEADLESS=1

# Optionnel — canal / version du binaire stealth.
# CLOAKBROWSER_RELEASE_CHANNEL=stable
# CLOAKBROWSER_VERSION=

# ── Parallélisme de capture ──────────────────────────────────────────────────
# Nombre d'ORIGINES capturées en parallèle. Les pages d'une même origine restent
# séquentielles (le WAF compte par origine), donc élargir le pool ajoute des
# marques en vol, jamais des hits simultanés sur une seule marque.
# Défaut 2. Chaque slot = une session CloakBrowser + un Chromium : au-delà de 2-3
# les métriques lab (TTFB, LCP) se dégradent, CPU et bande passante étant partagés.
# CAPTURE_CONCURRENCY=2

# Sessions concurrentes autorisées par le plan CloakBrowser (défaut 5).
# Sert uniquement à avertir quand CAPTURE_CONCURRENCY dépasse le plan.
# CLOAK_SESSION_LIMIT=5
